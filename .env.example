# ==========================================
# Database Connection (Required by Prisma)
# ==========================================
DATABASE_URL="postgresql://user:password@localhost:5432/auth_db?schema=public"

# ==========================================
# Server & Environment
# ==========================================
NODE_ENV="development"
PORT=3000
APP_BASE_URL="http://localhost:5173"

# ==========================================
# Authentication & Security Secrets
# ==========================================
# Secret key used for signing sessions and JWT tokens
AUTH_SECRET="your-32-character-or-longer-random-secret-key"
SESSION_SECRET="your-session-secret-key"

# Cost factor for bcrypt hashing (default: 15)
BCRYPT_SALT_ROUNDS=15

# ==========================================
# Email Service (Verification & Reset Emails)
# ==========================================
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
EMAIL_FROM="noreply@example.com"
